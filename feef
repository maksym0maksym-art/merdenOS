            shell_col = 0;
        }
        else
        {
            color_draw_char(
                text[i],
                shell_col * CHAR_WIDTH,
                shell_row * CHAR_HEIGHT,
                color
            );

            if (shell_col >= SCREEN_COLS)
            {
                shell_col = 0;
                shell_row++;
            }

            screen_buffers[shell_row][shell_col] = text[i];

            shell_col++;
        }

        if (shell_row >= SCREEN_ROW)
        {
            scrol_screen();
            shell_row--;
        }

        i++;
    }
}

