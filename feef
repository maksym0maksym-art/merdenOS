int shell_atoi(const char *str)
{
    int num = 0;
    int sign = 1;

    if (*str == '-')
    {
        sign = -1;
        str++;
    }

    while (*str >= '0' && *str <= '9')
    {
        num = num * 10 + (*str - '0');
        str++;
    }

    return num * sign;
}

int strncmp(const char *a, const char *b, int n)
{
    for(int i = 0; i < n; i++)
    {
        if (a[i] != b[i])
        {
            return a[i] - b[i];
        }

        if (a[i] == '\0')
        {
            return 0;
        }

    }
    return 0;
}

void shell_print(char* text)
{
    int i = 0;

    while (text[i] != '\0')
    {
        if (text[i] == '\n')
        {
