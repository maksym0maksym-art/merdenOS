void shell_calculator(char *command)
{
    char *p = command + 5; // після "calculator"

    while (*p == ' ')
        p++;

    int first = shell_atoi(p);

    while (*p >= '0' && *p <= '9')
        p++;

    while (*p == ' ')
        p++;

    char operation = *p;
    p++;

    while (*p == ' ')
        p++;

    int second = shell_atoi(p);
    int result = 0;

    switch (operation)
    {
        case '+':
            result = first + second;
            break;

        case '-':
            result = first - second;
            break;

        case '*':
            result = first * second;
            break;

        case '/':
            if (second == 0)
            {
                shell_print("Error: division by zero.\n");
                return;
            }

            result = first / second;
            break;

        default:
            shell_print("Usage: calculator <number> <+|-|*|/> <number>\n");
            return;
    }

    shell_print_int(result);
    shell_print("\n");
}
