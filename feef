char* shell_trim(char* str)
{
    if (!str) return str;

    // 1. Пропускаємо пробіли на початку
    char* start = str;
    while (*start == ' ' || *start == '\t' || *start == '\r' || *start == '\n')
    {
        start++;
    }

    // Якщо рядок весь складався з пробілів
    if (*start == '\0')
    {
        str[0] = '\0';
        return str;
    }

    // 2. Якщо початок зсунувся - переносимо рядок на початок буфера
    if (start != str)
    {
        int i = 0;
        while (start[i] != '\0')
        {
            str[i] = start[i];
            i++;
        }
        str[i] = '\0';
    }

    // 3. Обрізаємо пробіли з кінця
    int len = 0;
    while (str[len] != '\0') len++;

    while (len > 0 &&
          (str[len - 1] == ' ' || str[len - 1] == '\t' ||
           str[len - 1] == '\r' || str[len - 1] == '\n'))
    {
        str[len - 1] = '\0';
        len--;
    }

    return str;
}

void shell_enter()
{
    hide_cursor();

    if (editor_mode)
    {
        if (editor_len < EDITOR_MAX - 1)
        {
            editor_buffer[editor_len++] = '\n';
            editor_buffer[editor_len] = '\0';
        }

        shell_print("\n");

        editor_line_number++;
        char num_prefix[16];
        itoa(editor_line_number, num_prefix);
        shell_print(num_prefix);
        shell_print("| ");

        if (!editor_mode)   // перевірка
        {
            shell_prompt();
            show_cursor();
        }
        else
        {
            show_cursor();   // курсор все одно треба показати, просто без PROMPT
        }

        show_cursor();
        return;
    }

    command_buffer[command_index] = '\0';

    shell_trim(command_buffer);

    shell_print("\n");
    shell_history_add(command_buffer);   
    shell_execute_command(command_buffer);

    command_index = 0;
    shell_cursor_pos = 0; 
    command_buffer[0] = '\0';

    shell_prompt();
    show_cursor();
}

