<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="futures.MainWindow"
        Title="ProductivityGuard" 
        Width="400" 
        Height="450">
    <StackPanel Margin="20">
        <TextBlock Text="Виберіть процеси для блокування:" Margin="0,0,0,10"/>
        <ListBox x:Name="ProcessList" Height="300"/>
        <Button Content="Активувати" Click="Button_Click" HorizontalAlignment="Center" Margin="0,10,0,0"/>
    </StackPanel>
</Window>